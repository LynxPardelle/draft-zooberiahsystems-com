{
  "version": 1,
  "domain": "zooberiahsystems.com",
  "pageId": "blog",
  "components": [
    {
      "id": "sharedBlogMain",
      "type": "container",
      "config": {
        "tag": "main",
        "id": "main-content",
        "classes": "zShell zSection ank-display-flex ank-flexDirection-column ank-gap-24px",
        "components": [
          "sharedBlogTitle",
          "sharedBlogIntro",
          "sharedBlogCards",
          "sharedBlogEmpty"
        ],
        "tabindex": -1
      }
    },
    {
      "id": "sharedBlogTitle",
      "type": "text",
      "config": {
        "tag": "h1",
        "text": "Blog de ZooBeriah Systems",
        "classes": "zPageTitle"
      }
    },
    {
      "id": "sharedBlogIntro",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Guías y comparativas sobre sitios web, campañas, datos y aplicaciones para negocios.",
        "classes": "zLead"
      }
    },
    {
      "id": "sharedBlogCards",
      "type": "container",
      "config": {
        "tag": "section",
        "ariaLabel": "Artículos publicados",
        "classes": "ank-display-grid ank-gap-18px",
        "styles": {
          "gridTemplateColumns": "repeat(auto-fit, minmax(min(100%, 280px), 1fr))"
        },
        "components": []
      },
      "loopConfig": {
        "source": "var",
        "path": "contentHub.publicArticles.items",
        "templateId": "sharedBlogCard",
        "idPrefix": "sharedBlogCard",
        "bindings": [
          {
            "to": "config.title",
            "sources": [
              "title"
            ]
          },
          {
            "to": "config.description",
            "sources": [
              "summary"
            ]
          },
          {
            "to": "config.href",
            "sources": [
              "path"
            ]
          },
          {
            "to": "config.imageSrc",
            "sources": [
              "imageSrc"
            ]
          },
          {
            "to": "config.imageAlt",
            "sources": [
              "imageAlt"
            ]
          }
        ]
      }
    },
    {
      "id": "sharedBlogCard",
      "type": "generic-card",
      "config": {
        "variant": "feature",
        "title": "",
        "description": "",
        "href": "",
        "linkLabel": "Leer artículo",
        "imageSrc": "",
        "imageAlt": "",
        "classes": "ank-display-flex ank-flexDirection-column ank-gap-12px ank-paddingBlock-16px ank-width-100per ank-borderTop-2px__solid__accentColor",
        "imageContainerClasses": "ank-height-180px ank-overflow-hidden ank-borderRadius-3px",
        "imageClasses": "ank-width-100per ank-height-100per ank-objectFit-cover",
        "featureTitleClasses": "ank-color-titleColor ank-fontSize-22px ank-m-0",
        "featureDescriptionClasses": "ank-color-textColor ank-fontSize-16px ank-lineHeight-1_5",
        "linkClasses": "zTextLink ank-color-linkColor"
      }
    },
    {
      "id": "sharedBlogEmpty",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Todavía no hay artículos publicados en esta sección.",
        "classes": "ank-color-textColor ank-m-0"
      },
      "condition": "all:varLenEq,contentHub.publicArticles.items,0"
    }
  ]
}

    {
      "id": "footerWhatsappLink",
      "type": "link",
      "eventInstructions": "trackEvent:whatsapp_click,cta,footer_contact,location,footer",
      "valueInstructions": "set:config.text,i18n,ui.contact.footerLabel;set:config.href,i18n,ui.contact.whatsappUrl;set:config.ariaLabel,i18n,ui.contact.footerAriaLabel",
      "config": {
        "href": "#",
        "text": "",
        "ariaLabel": "",
        "target": "_blank",
        "rel": "noopener noreferrer",
        "classes": "zooberiahFooterActionLink"
      }

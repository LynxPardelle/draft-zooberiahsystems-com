{
  "version": 1,
  "domain": "zooberiahsystems.com",
  "pageId": "allPages",
  "components": [
    {
      "id": "skipToMainLink",
      "type": "link",
      "eventInstructions": "skipToMain:main-content",
      "valueInstructions": "set:config.text,i18n,ui.accessibility.skipToContent;set:config.ariaLabel,i18n,ui.accessibility.skipToContent",
      "config": {
        "id": "skip-to-main",
        "href": "#main-content",
        "text": "",
        "ariaLabel": "",
        "classes": "zooberiahSkipLink ank-color-bgColor"
      }
    },
    {
      "id": "siteHeader",
      "type": "container",
      "config": {
        "tag": "header",
        "classes": "zooberiahHeader",
        "components": [
          "headerInner",
          "headerMobileMenuMount"
        ]
      }
    },
    {
      "id": "headerInner",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "zooberiahHeaderInner zooberiahWrap",
        "components": [
          "headerBrand",
          "headerDesktopCluster",
          "headerMobileActions"
        ]
      }
    },
    {
      "id": "brandLink",
      "type": "link",
      "valueInstructions": "set:config.text,var,brand.displayName;set:config.ariaLabel,i18n,ui.accessibility.homeAriaLabel",
      "config": {
        "id": "site-brand",
        "href": "/",
        "text": "ZooBeriah Systems",
        "ariaLabel": "",
        "scrollRestoration": {
          "mode": "top",
          "behavior": "auto"
        },
        "classes": "zooberiahBrand ank-color-titleColor"
      }
    },
    {
      "id": "headerDesktopCluster",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "zooberiahDesktopCluster",
        "components": [
          "headerNav",
          "headerTalkLink"
        ]
      }
    },
    {
      "id": "headerNav",
      "type": "container",
      "valueInstructions": "set:config.ariaLabel,i18n,ui.accessibility.primaryNavigation",
      "config": {
        "tag": "nav",
        "ariaLabel": "",
        "classes": "zooberiahDesktopNav",
        "components": [
          "headerServicesLink",
          "headerCommerceLink",
          "headerProjectsLink",
          "headerBlogLink"
        ]
      }
    },
    {
      "id": "headerTalkLink",
      "type": "link",
      "valueInstructions": "set:config.text,i18n,nav.contact",
      "config": {
        "href": "/contacto",
        "text": "Contacto",
        "ariaLabel": "Contacto",
        "classes": "zooberiahPrimaryAction ank-color-bgColor"
      },
      "eventInstructions": "trackEvent:nav_click,navigation,contact,location,header"
    },
    {
      "id": "headerMobileActions",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "zooberiahMobileActions",
        "components": [
          "headerMobileNav"
        ]
      }
    },
    {
      "id": "headerMobileMenuMount",
      "type": "container",
      "config": {
        "tag": "div",
        "id": "mobile-menu-anchor",
        "classes": "ank-display-lg-none ank-width-100per zooberiahWrap",
        "components": []
      }
    },
    {
      "id": "headerMobileNav",
      "type": "dropdown",
      "condition": "all:navigation,exists",
      "valueInstructions": "set:config.items,var,navigation;set:config.dropdownConfig.ariaLabel,i18n,ui.accessibility.mobileMenuAriaLabel",
      "config": {
        "items": [],
        "dropdownConfig": {
          "ariaLabel": "",
          "buttonClasses": "zooberiahMobileTrigger",
          "itemLinkClasses": "zooberiahMobileItem ank-color-titleColor",
          "menuContainerClasses": "zooberiahMobileMenuContainer",
          "menuNavClasses": "zooberiahWrap",
          "menuListClasses": "zooberiahMobileMenuList",
          "renderMode": "inline",
          "menuContainerId": "mobile-primary-navigation",
          "inlinePortalTargetSelector": "#mobile-menu-anchor",
          "closeOnSelect": true
        },
        "components": [
          "mobileMenuIcon"
        ]
      }
    },
    {
      "id": "mobileMenuIcon",
      "type": "icon",
      "config": {
        "iconName": "menu",
        "ariaHidden": true,
        "classes": "ank-display-block ank-width-24px ank-height-24px ank-color-titleColor"
      }
    },
    {
      "id": "siteFooter",
      "type": "container",
      "config": {
        "tag": "footer",
        "id": "site-footer",
        "classes": "zooberiahFooter ank-color-HASHF6F4EE",
        "components": [
          "footerInner"
        ]
      }
    },
    {
      "id": "footerInner",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "zooberiahFooterInner zooberiahWrap",
        "components": [
          "footerBrandBlock",
          "footerNav",
          "footerActionBlock"
        ]
      }
    },
    {
      "id": "footerBrandBlock",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "zooberiahStack",
        "components": [
          "footerBrandLink",
          "footerTagline",
          "footerLocation"
        ]
      }
    },
    {
      "id": "footerBrandLink",
      "type": "link",
      "valueInstructions": "set:config.text,var,brand.displayName;set:config.ariaLabel,i18n,ui.accessibility.homeAriaLabel",
      "config": {
        "href": "/",
        "text": "ZooBeriah Systems",
        "ariaLabel": "",
        "scrollRestoration": {
          "mode": "top",
          "behavior": "auto"
        },
        "classes": "zooberiahFooterBrand"
      }
    },
    {
      "id": "footerTagline",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,footer.tagline",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "zooberiahFooterText"
      }
    },
    {
      "id": "footerLocation",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,footer.location",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "zooberiahFooterText"
      }
    },
    {
      "id": "footerNav",
      "type": "container",
      "valueInstructions": "set:config.ariaLabel,i18n,ui.accessibility.footerNavigation",
      "config": {
        "tag": "nav",
        "ariaLabel": "",
        "classes": "zooberiahFooterNav",
        "components": [
          "footerServicesLink",
          "footerCommerceLink",
          "footerProjectsLink",
          "footerBlogLink",
          "footerContactLink"
        ]
      }
    },
    {
      "id": "footerActionBlock",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "zooberiahFooterAction",
        "components": [
          "footerWhatsappLink",
          "footerPhone",
          "footerCopyright"
        ]
      }
    },
    {
      "id": "footerWhatsappLink",
      "type": "link",
      "eventInstructions": "trackEvent:whatsapp_click,cta,footer_contact,location,footer",
      "valueInstructions": "set:config.text,i18n,ui.contact.footerLabel;set:config.href,i18n,ui.contact.whatsappUrl;set:config.ariaLabel,i18n,ui.contact.footerAriaLabel",
      "config": {
        "href": "#",
        "text": "",
        "ariaLabel": "",
        "target": "_blank",
        "rel": "noopener noreferrer",
        "classes": "zooberiahFooterActionLink ank-color-HASH102D32",
        "components": [
          "footerWhatsappIcon"
        ]
      }
    },
    {
      "id": "footerPhone",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,ui.contact.visiblePhone",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "zooberiahPhoneText"
      }
    },
    {
      "id": "footerCopyright",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,footer.copyright",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "zooberiahFooterText"
      }
    },
    {
      "id": "headerBrand",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-display-flex ank-alignItems-center ank-gap-10px",
        "components": [
          "headerBrandMark",
          "brandLink"
        ]
      }
    },
    {
      "id": "headerBrandMark",
      "type": "icon",
      "config": {
        "iconName": "dashboard_customize",
        "classes": "zBrandMark",
        "ariaHidden": true
      }
    },
    {
      "id": "footerWhatsappIcon",
      "type": "icon",
      "config": {
        "iconName": "chat",
        "classes": "ank-fontSize-18px",
        "ariaHidden": true
      }
    },
    {
      "id": "headerServicesLink",
      "type": "link",
      "config": {
        "text": "Servicios",
        "href": "/servicios",
        "classes": "zooberiahNavLink ank-color-textColor"
      },
      "eventInstructions": "trackEvent:nav_click,navigation,servicios,location,header"
    },
    {
      "id": "headerCommerceLink",
      "type": "link",
      "config": {
        "text": "Tiendas en línea",
        "href": "/tiendas-en-linea",
        "classes": "zooberiahNavLink ank-color-textColor"
      },
      "eventInstructions": "trackEvent:nav_click,navigation,tiendas-en-linea,location,header"
    },
    {
      "id": "headerProjectsLink",
      "type": "link",
      "config": {
        "text": "Proyectos",
        "href": "/proyectos",
        "classes": "zooberiahNavLink ank-color-textColor"
      },
      "eventInstructions": "trackEvent:nav_click,navigation,proyectos,location,header"
    },
    {
      "id": "headerBlogLink",
      "type": "link",
      "config": {
        "text": "Blog",
        "href": "/blog",
        "classes": "zooberiahNavLink ank-color-textColor"
      },
      "eventInstructions": "trackEvent:nav_click,navigation,blog,location,header"
    },
    {
      "id": "footerServicesLink",
      "type": "link",
      "config": {
        "text": "Servicios",
        "href": "/servicios",
        "classes": "zooberiahFooterLink"
      }
    },
    {
      "id": "footerCommerceLink",
      "type": "link",
      "config": {
        "text": "Tiendas en línea",
        "href": "/tiendas-en-linea",
        "classes": "zooberiahFooterLink"
      }
    },
    {
      "id": "footerProjectsLink",
      "type": "link",
      "config": {
        "text": "Proyectos",
        "href": "/proyectos",
        "classes": "zooberiahFooterLink"
      }
    },
    {
      "id": "footerBlogLink",
      "type": "link",
      "config": {
        "text": "Blog",
        "href": "/blog",
        "classes": "zooberiahFooterLink"
      }
    },
    {
      "id": "footerContactLink",
      "type": "link",
      "config": {
        "text": "Contacto",
        "href": "/contacto",
        "classes": "zooberiahFooterLink"
      }
    }
  ]
}

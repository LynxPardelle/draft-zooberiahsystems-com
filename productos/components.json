{
  "version": 1,
  "domain": "zooberiahsystems.com",
  "pageId": "productos",
  "components": [
    {
      "id": "productsEyebrow",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "zEyebrow"
      },
      "valueInstructions": "set:config.text,i18n,page.productsEyebrow"
    },
    {
      "id": "productsTitle",
      "type": "text",
      "config": {
        "tag": "h1",
        "text": "",
        "classes": "zPageTitle ank-maxWidth-22ch"
      },
      "valueInstructions": "set:config.text,i18n,page.productsTitle"
    },
    {
      "id": "productsLead",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "zLead ank-maxWidth-65ch"
      },
      "valueInstructions": "set:config.text,i18n,page.productsLead"
    },
    {
      "id": "productsHero",
      "type": "container",
      "config": {
        "tag": "section",
        "classes": "zPageHero",
        "components": [
          "productsHeroContent"
        ],
        "id": "productos"
      }
    },
    {
      "id": "productsWebTitle",
      "type": "text",
      "config": {
        "tag": "h2",
        "text": "",
        "classes": "zSectionTitle"
      },
      "valueInstructions": "set:config.text,i18n,page.productsWebTitle"
    },
    {
      "id": "productsWebText",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "zLead"
      },
      "valueInstructions": "set:config.text,i18n,page.productsWebText"
    },
    {
      "id": "productsGallery",
      "type": "link",
      "config": {
        "text": "",
        "href": "/sitios-web",
        "classes": "zTextLink ank-color-linkColor"
      },
      "valueInstructions": "set:config.text,i18n,page.productsGallery"
    },
    {
      "id": "productsContact",
      "type": "link",
      "config": {
        "text": "",
        "href": "/contacto",
        "classes": "zTextLink ank-color-linkColor"
      },
      "valueInstructions": "set:config.text,i18n,page.productsContact"
    },
    {
      "id": "productsWebActions",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "zActions",
        "components": [
          "productsGallery",
          "productsContact"
        ]
      }
    },
    {
      "id": "productsWeb",
      "type": "container",
      "config": {
        "tag": "section",
        "classes": "zSection",
        "components": [
          "productsWebContent"
        ],
        "id": "crear-landingpage"
      }
    },
    {
      "id": "productsMain",
      "type": "container",
      "config": {
        "tag": "main",
        "classes": "zMain",
        "components": [
          "productsHero",
          "productsList",
          "productsWeb"
        ],
        "id": "main-content",
        "role": "main",
        "tabindex": -1
      }
    },
    {
      "id": "productsHeroContent",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "zShell zProse",
        "components": [
          "productsEyebrow",
          "productsTitle",
          "productsLead"
        ]
      }
    },
    {
      "id": "productsWebContent",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "zShell zProse",
        "components": [
          "productsWebTitle",
          "productsWebText",
          "productsWebActions"
        ]
      }
    },
    {
      "id": "productsList",
      "type": "container",
      "config": {
        "tag": "div",
        "styles": {
          "display": "contents"
        },
        "components": []
      },
      "loopConfig": {
        "source": "var",
        "path": "products.items",
        "templateId": "productSection",
        "bindings": [
          {
            "to": "config.id",
            "sources": [
              "id"
            ]
          }
        ]
      }
    },
    {
      "type": "container",
      "config": {
        "tag": "section",
        "classes": "zSection",
        "components": [
          "productSectionContent__{{index}}"
        ],
        "id": "product-section"
      },
      "id": "productSection"
    },
    {
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "zShell",
        "components": [
          "productSplit__{{index}}"
        ]
      },
      "id": "productSectionContent",
      "loopConfig": {
        "source": "var",
        "path": "products.items",
        "templateId": "productSectionContent"
      }
    },
    {
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "zSplit",
        "components": [
          "productImage__{{index}}",
          "productCopy__{{index}}"
        ]
      },
      "id": "productSplit",
      "loopConfig": {
        "source": "var",
        "path": "products.items",
        "templateId": "productSplit"
      }
    },
    {
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "zProse",
        "components": [
          "productEyebrow__{{index}}",
          "productTitle__{{index}}",
          "productDescription__{{index}}",
          "productVisit__{{index}}"
        ]
      },
      "id": "productCopy",
      "loopConfig": {
        "source": "var",
        "path": "products.items",
        "templateId": "productCopy"
      }
    },
    {
      "type": "media",
      "config": {
        "tag": "image",
        "src": "",
        "alt": "",
        "width": 1280,
        "height": 800,
        "loading": "lazy",
        "decoding": "async",
        "classes": "zMedia"
      },
      "id": "productImage",
      "loopConfig": {
        "source": "var",
        "path": "products.items",
        "templateId": "productImage",
        "bindings": [
          {
            "to": "config.src",
            "sources": [
              "imageSrc"
            ]
          },
          {
            "to": "config.alt",
            "sources": [
              "imageAlt"
            ]
          },
          {
            "to": "config.loading",
            "sources": [
              "imageLoading"
            ]
          },
          {
            "to": "config.fetchPriority",
            "sources": [
              "imageFetchPriority"
            ]
          }
        ]
      }
    },
    {
      "type": "text",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "zEyebrow"
      },
      "id": "productEyebrow",
      "loopConfig": {
        "source": "var",
        "path": "products.items",
        "templateId": "productEyebrow",
        "bindings": [
          {
            "to": "config.text",
            "sources": [
              "eyebrow"
            ]
          }
        ]
      }
    },
    {
      "type": "text",
      "config": {
        "tag": "h2",
        "text": "",
        "classes": "zSectionTitle"
      },
      "id": "productTitle",
      "loopConfig": {
        "source": "var",
        "path": "products.items",
        "templateId": "productTitle",
        "bindings": [
          {
            "to": "config.text",
            "sources": [
              "title"
            ]
          }
        ]
      }
    },
    {
      "type": "text",
      "config": {
        "tag": "p",
        "text": "",
        "classes": "zLead"
      },
      "id": "productDescription",
      "loopConfig": {
        "source": "var",
        "path": "products.items",
        "templateId": "productDescription",
        "bindings": [
          {
            "to": "config.text",
            "sources": [
              "description"
            ]
          }
        ]
      }
    },
    {
      "type": "link",
      "config": {
        "text": "Ver producto",
        "href": "",
        "classes": "zPrimaryAction ank-color-bgColor"
      },
      "id": "productVisit",
      "loopConfig": {
        "source": "var",
        "path": "products.items",
        "templateId": "productVisit",
        "bindings": [
          {
            "to": "config.href",
            "sources": [
              "url"
            ]
          },
          {
            "to": "config.text",
            "sources": [
              "linkLabel"
            ]
          }
        ]
      }
    }
  ]
}

          "linkColor": "#00F5F2",
          "accentColor": "#00F5F2",
          "secondaryBgColor": "#011218",
          "secondaryTextColor": "#B8CED1",
          "secondaryTitleColor": "#FFFFFF",
          "secondaryLinkColor": "#00F5F2",
          "secondaryAccentColor": "#B3F71F",
          "successColor": "#08F394",
          "onSuccessColor": "#000000",
          "errorColor": "#FF4DA6",
          "onErrorColor": "#000000",
          "warningColor": "#B3F71F",
          "onWarningColor": "#000000",
          "infoColor": "#07BDDB",
          "onInfoColor": "#000000"
        },
        "dark": {
          "bgColor": "#000000",
          "textColor": "#FFFFFF",
          "titleColor": "#FFFFFF",
          "linkColor": "#00F5F2",
          "accentColor": "#00F5F2",
          "secondaryBgColor": "#011218",

        "progressBarClasses": "ank-height-100per",
        "progressBarSurfaceClasses": "ank-bg-accentColor",
        "iconSurfaceClasses": "ank-bg-bgColorOPA__0_28 ank-color-inherit",
        "iconContainerClasses": "ank-display-flex ank-alignItems-center ank-justifyContent-center ank-flexShrink-0 ank-width-24px ank-height-24px ank-borderRadius-50per",
        "contentClasses": "ank-display-flex ank-flexDirection-column ank-gap-4px ank-flex-1 ank-minWidth-0",
        "titleClasses": "ank-fontSize-1rem ank-fontWeight-600 ank-lineHeight-1_3",
        "textClasses": "ank-fontSize-0_9rem ank-lineHeight-1_5",
        "actionsClasses": "ank-display-flex ank-flexWrap-wrap ank-gap-8px ank-marginTop-8px",
        "actionButtonClasses": "ank-minHeight-44px ank-paddingInline-12px ank-paddingBlock-8px ank-borderRadius-12px ank-cursor-pointer ank-fontWeight-600 ank-outlineFocus-3px__solid__accentColor ank-outlineOffsetFocus-4px",
        "actionPrimaryClasses": "ank-border-1px__solid__accentColor ank-bg-accentColor ank-color-bgColor",
        "actionSecondaryClasses": "ank-border-1px__solid__accentColor ank-bg-transparent ank-color-titleColor",
        "dismissButtonClasses": "ank-display-flex ank-alignItems-center ank-justifyContent-center ank-flexShrink-0 ank-width-44px ank-height-44px ank-bg-transparent ank-border-0 ank-borderRadius-12px ank-cursor-pointer ank-color-inherit ank-outlineFocus-3px__solid__accentColor ank-outlineOffsetFocus-4px"
      }
    }
  },
  "runtime": {
    "localStorage": {
      "theme": "zooberiah-theme",
      "language": "zooberiah-language",
      "userPreferences": "zooberiah-preferences",
      "id": "zooberiah-id",
      "sessionId": "zooberiah-session-id",
      "allowAnalytics": "zooberiah-allow-analytics",
      "analyticsConsentSnooze": "zooberiah-analytics-consent-snooze",
      "pageViewCount": "zooberiah-page-view-count"
    },
    "features": {
      "debugMode": false
    },
    "navigation": {
      "scrollRestoration": {
        "mode": "preserve",
        "behavior": "auto"
      }
    },
    "analytics": {
      "enabled": true,
      "consentUI": "toast",
      "consentSnoozeSeconds": 86400,
      "track": [
        "language",
        "platform",
        "screenWidth",
        "screenHeight",
        "timezone"
      ],
      "events": {
        "page_view": "page_view",
        "nav_click": "nav_click",
        "section_view": "section_view",
        "scroll_depth": "scroll_depth",
        "faq_open": "faq_open",
        "cta_click": "cta_click",
        "whatsapp_click": "whatsapp_click"
      },
      "categories": {
        "navigation": "navigation",
        "engagement": "engagement",
        "faq": "faq",
        "cta": "cta"
      },
      "quickStats": {
        "pageView": {
          "event": "page_view",
          "path": "metrics.pageViews",
          "by": 1
        },
        "events": [
          {
            "name": "cta_click",
            "path": "metrics.ctaClicks",
            "by": 1
          },
          {
            "name": "whatsapp_click",
            "path": "metrics.whatsappClicks",
            "by": 1
          }
        ]
      }
    }
  },
  "notFoundPageId": "not-found",
  "sitemap": {
    "excludePaths": [
      "/404"
    ]
  }
}

    "appIdentity": {
      "identifier": "zooberiahsystemscom",
      "name": "ZooBeriah Systems",
      "version": "1.0.0",
      "description": "Diseñamos sitios web, tiendas en línea y sistemas a medida para negocios. Consultoría tecnológica, datos e inteligencia artificial desde Ciudad de México."
    },
    "seo": {
      "siteName": "ZooBeriah Systems",
      "title": "ZooBeriah Systems | Consultoría y desarrollo digital en CDMX",
      "description": "Diseñamos sitios web, tiendas en línea y sistemas a medida para negocios. Consultoría tecnológica, datos e inteligencia artificial desde Ciudad de México.",
      "canonicalOrigin": "https://zooberiahsystems.com",
      "enforceCanonicalHost": true,
      "forceHttps": true,
      "openGraph": {
        "type": "website",
        "site_name": "ZooBeriah Systems",
        "image": "https://assets.zoolandingpage.com.mx/zooberiahsystems.com/shared/seo-images/identity-20261120-social.jpg",
        "imageAlt": "ZooBeriah Systems: jaguar luminoso, nodos conectados y onda verde y turquesa sobre negro."
      },
      "twitter": {
        "card": "summary_large_image",
        "image": "https://assets.zoolandingpage.com.mx/zooberiahsystems.com/shared/seo-images/identity-20261120-social.jpg",
        "imageAlt": "ZooBeriah Systems: jaguar luminoso, nodos conectados y onda verde y turquesa sobre negro."
      },
      "keywords": {
        "es": [
          "consultoría tecnológica",
          "consultoría de datos",
          "inteligencia artificial para negocios",
          "soluciones digitales",
          "ZooBeriah Systems"
        ]
      },
      "robots": "index,follow",
      "redirects": [
        {
          "from": "/landingpages",
          "to": "/sitios-web",
          "preserveQueryParams": [
            "q",
            "categoria",
            "lang"
          ]
        }
      ]
    },
    "i18n": {
      "defaultLanguage": "es",
      "supportedLanguages": [
        {
          "code": "es",
          "label": "ES",
          "dir": "ltr",
          "ogLocale": "es_MX"
        }
      ]
    },
    "icons": {
      "themeColor": "#000000",
      "favicon": "https://assets.zoolandingpage.com.mx/zooberiahsystems.com/shared/logos/identity-20261120-favicon.png",
      "appleTouchIcon": "https://assets.zoolandingpage.com.mx/zooberiahsystems.com/shared/logos/identity-20261120-touch-icon.png"
    },
    "fonts": [
      {
        "family": "Rajdhani",
        "src": "https://fonts.gstatic.com/s/rajdhani/v17/LDI2apCSOBg7S-QT7pbYF_Oreec.woff2",
        "weight": "600",
        "style": "normal"
      },

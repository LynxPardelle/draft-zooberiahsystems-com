    "appIdentity": {
      "identifier": "zooberiahsystemscom",
      "name": "ZooBeriah Systems",
      "version": "1.0.0",
      "description": "Consultoría tecnológica, de datos e IA para negocios locales."
    },
    "seo": {
      "siteName": "ZooBeriah Systems",
      "title": "ZooBeriah Systems | Consultoría tecnológica, datos e IA",
      "description": "Consultoría tecnológica, de datos e IA para negocios locales. Definimos acciones y desarrollamos soluciones digitales. Atención remota desde CDMX.",
      "openGraph": {
        "type": "website",
        "site_name": "ZooBeriah Systems"
      },
      "twitter": {
        "card": "summary"
      },
      "keywords": {
        "es": [
          "consultoría tecnológica",
          "consultoría de datos",
          "inteligencia artificial para negocios",
          "soluciones digitales",
          "ZooBeriah Systems"
        ]
      },
      "robots": "noindex,nofollow"
    },
    "i18n": {
      "defaultLanguage": "es",
      "supportedLanguages": [
        {
          "code": "es",
          "label": "ES",
          "dir": "ltr",
          "ogLocale": "es_MX"
        }
      ]
    },
    "icons": {
      "themeColor": "#102D32"
    }
  },
  "defaults": {
    "brand": {
      "displayName": "ZooBeriah Systems",
      "tagline": "Ideas que toman forma digital."
    },
    "ui": {
      "contact": {
        "whatsappPhone": "+525522699563",
        "whatsappMessageKey": "ui.contact.whatsappMessage"
      },
      "toast": {
        "hostClasses": "ank-position-fixed ank-display-flex ank-flexDirection-column ank-gap-8px ank-zIndex-1400 ank-pointerEvents-none",
        "hostTopClasses": "ank-top-16px",
        "hostBottomClasses": "ank-bottom-16px",
        "hostLeftClasses": "ank-left-16px",
        "hostRightClasses": "ank-right-16px",
        "hostCenterClasses": "ank-left-50per ank-transform-translateXSDMIN50perED",
        "itemClasses": "ank-position-relative ank-width-92vw ank-maxWidth-26rem ank-display-flex ank-alignItems-stretch ank-gap-12px ank-padding-16px ank-borderRadius-12px ank-boxShadow-0__16px__40px__rgbaSD16COM45COM50COM0_18ED ank-border-1px__solid ank-pointerEvents-auto ank-overflow-hidden ank-bg-bgColor ank-color-textColor",
        "hoveredItemClasses": "ank-boxShadow-0__16px__40px__rgbaSD16COM45COM50COM0_18ED",
        "levelSuccessClasses": "ank-bg-successColor ank-color-onSuccessColor ank-borderColor-successColor",
        "levelErrorClasses": "ank-bg-errorColor ank-color-onErrorColor ank-borderColor-errorColor",
